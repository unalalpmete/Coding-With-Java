
public class MyLinkedListReverse {

	// Her bir veriyi ve baglantiyi tutan Dugum yapisi
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }
    
    Node head; // Listenin başlangıç noktası

    
     // TERSINE CEVIRME ALGORITMASI
     //  Her dugumun 'ileri' bakan okunu 'geriye' çevirmek.
   
    public void reverse() {
        Node prev = null;    // Bir onceki dugum (baslangicta null cunku ilkin arkasi bostur)
        Node current = head; // su an uzerinde oldugumuz dugum
        Node next = null;    // Bir sonraki dugumu kaybetmemek icin kullandigimiz geçici saklama alani

        while (current != null) {
            // 1. Mevcut düğümün bağlantısını koparmadan önce sonrakini yedekle
            next = current.next; 
            
            // 2. Mevcut düğümün 'ileri' bakan okunu 'geriye' (prev) çevir
            current.next = prev; 
            
            // 3. İşaretçileri birer vagon sağa kaydır
            prev = current;   // Artık 'current', bir sonraki adımın 'öncesi' oldu
            current = next;   // 'current' artık bir sonraki düğüme geçti
        }

        // 4. Döngü bittiğinde 'prev' eski listenin sonuncusuna (yeni listenin başına) ulaşır.
        head = prev;
    }
    
    // Sona eleman ekleme metodu
    public void add(int data) {
        Node newNode = new Node(data);
        if (head == null) {
            head = newNode;
            return;
        }
        Node temp = head;
        while (temp.next != null) {
            temp = temp.next;
        }
        temp.next = newNode;
    }

    //  Listeyi ekrana yazdırma metodu
    public void printList() {
        Node temp = head;
        while (temp != null) {
            System.out.print(temp.data + " -> ");
            temp = temp.next;
        }
        System.out.println("null");
    }
    
    
	public static void main(String[] args) {
		MyLinkedListReverse list = new MyLinkedListReverse();
        list.add(10);
        list.add(20);
        list.add(30);

        System.out.print("Orijinal: ");
        list.printList();

        list.reverse();

        System.out.print("Tersine:  ");
        list.printList();

	}

}
